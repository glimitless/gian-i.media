{
  "id": "visual-research",
  "content": {
    "description": [
      [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "A collection of 2D visualizations that diagram possible structures of time, as defined by the spiral treatise. Rather than a single definitive form, the book invites viewers to reconsider time beyond linear frameworks."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Printed on 100 lb white matte paper, spiral bound with an acetate front cover and black cardstock back cover."
            }
          ]
        }
      ]
    ],
