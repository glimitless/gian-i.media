{
  "id": "timeout",
  "content": {
    "description": [
      [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "In my third year, Design Photography monitors and faculty were invited to submit summer photographs for ‘Timeout: A Visual Record of the Summer’, a fall exhibition documenting the community’s break."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Three of my photographs were included. I designed a template for exhibitors’ artist statements and an accordion-fold handout, giving the show a consistent framework and context for visitors."
            }
          ]
        }
      ]
    ],
