    "description": [
      [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The site comprises a main page and a News & Events page. The main page draws on treatise scrolls, continuous rolls used for formal scientific and ethical argument, here focused on black carbon pollution and SensingChange’s work to make it visible. News & Events extends that scroll vernacular into an updatable template so the community can follow project developments in one place."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The site has since been expanded; visit "
            },
            {
              "type": "external-link",
              "href": "https://myairwear.com/",
              "label": "myairwear.com"
            },
            {
              "type": "text",
              "value": "."
            }
          ]
        }
      ]
    ],
