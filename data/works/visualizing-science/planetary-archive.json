{
  "id": "planetary-archive",
  "content": {
    "description": [
      [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "In Graphic Design 2 (second year), we designed, built, and published a resource website while avoiding the hyper-commodified look of much of the contemporary web."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "Mine shares information about the solar system as a planetarium with the user at the centre. Selecting a planet reveals detail; a control at lower left switches to a comparison of orbital speeds."
            }
          ]
        }
      ]
    ],
    "items": [
