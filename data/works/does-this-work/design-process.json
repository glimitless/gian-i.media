{
  "id": "design-process",
  "content": {
    "description": [
      [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "I framed my process as “the simplification of excess”: moving through vast possibilities to reach the most effective solution for the task."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "value": "The book opens with dense visual stimuli and gradually reduces complexity until a single note acknowledges that the process is still evolving as my practice grows."
            }
          ]
        }
      ]
    ],
